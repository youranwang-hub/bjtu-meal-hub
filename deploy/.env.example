# 复制为 /opt/bjtu-meal/.env 并填入真实值。
# 注意：.env 不要提交到 Git，README 已用 .gitignore 排除。

# Flask 会话签名密钥，生成方式：
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 生产环境开关，必须设为 production。
# 作用：关闭开发环境的模拟登录回退（dev-admin），未配置微信登录时直接拒绝。
FLASK_ENV=production

# 微信小程序 AppID / AppSecret
# 位置：微信公众平台 -> 开发管理 -> 开发设置 -> 开发者ID
WECHAT_APPID=
WECHAT_APPSECRET=

# 管理员 openid 白名单，多个用英文逗号分隔。
# 获取方式：先用真机登录一次小程序，然后查服务器 database.db：
#   sqlite3 /opt/bjtu-meal/database.db "SELECT openid, user_id FROM wechat_identity;"
WECHAT_ADMIN_OPENIDS=

# 微信文本内容安全（建议登录跑通后再开启）。
# 开启前必须保证上面 AppID/Secret 已正确配置。
#WECHAT_CONTENT_SAFETY=1
#WECHAT_CONTENT_SAFETY_FAIL_CLOSED=1
