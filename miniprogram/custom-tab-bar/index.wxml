<view class="bar"><view class="nav"><view class="nav-notch"></view><view class="nav-item {{activePath === item.path ? 'active' : ''}}" wx:for="{{left}}" wx:key="path" data-path="{{item.path}}" bindtap="switchTab"><image class="icon" src="{{item.icon}}" mode="aspectFit"/><text>{{item.text}}</text></view><view class="nav-gap"></view><view class="nav-item {{activePath === item.path ? 'active' : ''}}" wx:for="{{right}}" wx:key="path" data-path="{{item.path}}" bindtap="switchTab"><image class="icon" src="{{item.icon}}" mode="aspectFit"/><text>{{item.text}}</text></view></view><view class="action" bindtap="action"><view class="dice-face"><view class="dice-dot one"></view><view class="dice-dot two"></view><view class="dice-dot three"></view><view class="dice-dot four"></view></view></view></view><view wx:if="{{actionOpen}}" class="decision-mask"><view class="decision-popup"><view class="decision-close" bindtap="closeAction">×</view><view class="decision-eyebrow">MEAL DECISION</view><view class="popup-dice"><view class="dice-dot one"></view><view class="dice-dot two"></view><view class="dice-dot three"></view><view class="dice-dot four"></view></view><view class="decision-title">今天吃什么？</view><view class="decision-copy">还没想好就交给一点运气，按现在的餐次为你选一道菜。</view><button class="decision-button" loading="{{deciding}}" bindtap="dice">替我决定</button><view class="decision-meal">{{mealLabel ? '为你挑选 ' + mealLabel : '点击骰子，开始选餐'}}</view><view class="decision-tip">吃完后想留记录？去“打卡”完成这一餐，再拍照留念。</view><view wx:if="{{randomDish}}" class="random-card" bindtap="openDish"><view class="decision-eyebrow">{{mealLabel}} DICE RESULT</view><view class="random-name">{{randomDish.name}}</view><view class="random-copy">{{randomDish.canteenName}} · {{randomDish.stallName}}</view><view class="random-bottom"><text>¥{{randomDish.specialPrice || randomDish.price}}</text><text>去看看 ›</text></view></view></view></view>
