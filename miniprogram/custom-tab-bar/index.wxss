.bar{height:120rpx;position:relative;background:transparent;padding:0 24rpx 18rpx;box-sizing:border-box}.nav{position:relative;height:90rpx;border:2rpx solid rgba(117,91,60,.12);background:rgba(255,255,255,.92);border-radius:52rpx;display:flex;align-items:center;justify-content:space-around;box-shadow:0 8rpx 22rpx rgba(80,60,36,.08);overflow:visible}.nav-notch{position:absolute;z-index:1;left:50%;top:-28rpx;transform:translateX(-50%);width:142rpx;height:72rpx;background:#f3f0e7;border-radius:0 0 80rpx 80rpx}.nav-item{position:relative;z-index:2;height:70rpx;width:108rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#75665d;font-size:21rpx;transition:all .18s ease}.icon{width:31rpx;height:31rpx;margin-bottom:3rpx;opacity:.76}.nav-item.active{color:#b77b35;font-weight:600}.nav-item.active .icon{opacity:1;filter:sepia(76%) saturate(120%) hue-rotate(350deg) brightness(87%)}.nav-gap{width:120rpx}.action{position:absolute;z-index:3;left:50%;top:-35rpx;transform:translateX(-50%);width:106rpx;height:106rpx;border-radius:50%;background:#6c5140;border:7rpx solid #f3f0e7;box-shadow:0 9rpx 20rpx rgba(78,54,31,.22);display:flex;align-items:center;justify-content:center}.dice-face,.popup-dice{position:relative;border-radius:18rpx;background:#f8eedc;box-shadow:inset 0 -3rpx 0 rgba(119,83,45,.15)}.dice-face{width:48rpx;height:48rpx}.popup-dice{width:78rpx;height:78rpx;margin:22rpx auto 14rpx;border-radius:23rpx;background:#6c5140;box-shadow:0 7rpx 15rpx rgba(91,69,44,.16)}.dice-dot{position:absolute;width:9rpx;height:9rpx;border-radius:50%;background:#6c5140}.popup-dice .dice-dot{background:#f8eedc;width:12rpx;height:12rpx}.one{left:11rpx;top:11rpx}.two{right:11rpx;top:11rpx}.three{left:11rpx;bottom:11rpx}.four{right:11rpx;bottom:11rpx}.popup-dice .one{left:17rpx;top:17rpx}.popup-dice .two{right:17rpx;top:17rpx}.popup-dice .three{left:17rpx;bottom:17rpx}.popup-dice .four{right:17rpx;bottom:17rpx}.decision-mask{position:fixed;z-index:1000;inset:0;background:rgba(65,52,44,.34);display:flex;align-items:center;justify-content:center;padding:34rpx;box-sizing:border-box}.decision-popup{position:relative;width:100%;box-sizing:border-box;background:#fff;border-radius:42rpx;padding:46rpx 32rpx 31rpx;text-align:center;box-shadow:0 16rpx 38rpx rgba(51,34,17,.2)}.decision-close{position:absolute;right:23rpx;top:12rpx;color:#8e7b6b;font-size:42rpx}.decision-eyebrow{font-family:Georgia,serif;font-size:19rpx;letter-spacing:3rpx;color:#a58b6b}.decision-title{font-family:Georgia,serif;font-size:48rpx;font-weight:bold;margin:14rpx 0;color:#553f2e}.decision-copy{color:#8b796d;font-size:25rpx;line-height:1.6}.decision-button{margin:31rpx 0 12rpx;background:#6c5140;color:#fff;border-radius:35rpx;font-size:28rpx;letter-spacing:1rpx;box-shadow:0 8rpx 16rpx rgba(91,69,44,.18)}.decision-meal{font-size:22rpx;color:#a17f61}.decision-tip{margin-top:27rpx;padding:19rpx;border-radius:19rpx;background:#f6eee0;color:#796350;font-size:23rpx;line-height:1.6;text-align:left}.random-card{margin-top:22rpx;background:#6c5140;color:#fff;border-radius:28rpx;padding:26rpx;text-align:left}.random-card .decision-eyebrow{color:#e8cb9e}.random-name{font-family:Georgia,serif;font-size:38rpx;font-weight:bold;margin:9rpx 0}.random-copy{color:#e5d6c8;font-size:23rpx}.random-bottom{display:flex;justify-content:space-between;margin-top:18rpx;color:#f1cf92;font-family:Georgia,serif;font-size:28rpx}
