.community-head{padding:12rpx 3rpx 24rpx}.eyebrow{font-family:Georgia,serif;color:#a58b6b;font-size:19rpx;letter-spacing:3rpx}.title{font-family:Georgia,serif;font-size:42rpx;font-weight:bold;margin-top:8rpx}.author{display:flex;align-items:center;gap:12rpx;font-weight:bold;margin-bottom:16rpx}.avatar{width:42rpx;height:42rpx;border-radius:50%;background:#e1c999;color:#735538;display:flex;align-items:center;justify-content:center;font-size:20rpx}.content{line-height:1.65;margin-bottom:16rpx;white-space:pre-wrap}.post-img{width:100%;height:310rpx;border-radius:20rpx;margin-bottom:16rpx;background:#eee}.post-foot{display:flex;justify-content:space-between;color:#98877a;font-size:22rpx}.post-foot view text{margin-left:22rpx}.float-add{position:fixed;right:35rpx;bottom:150rpx;width:100rpx;height:100rpx;border-radius:50%;background:#b87a36;color:#fff;font-size:58rpx;line-height:92rpx;text-align:center;box-shadow:0 12rpx 24rpx rgba(91,59,26,.25)}.mask{position:fixed;z-index:100;inset:0;background:rgba(65,52,44,.3)}.compose{position:absolute;left:30rpx;right:30rpx;top:50%;transform:translateY(-50%);background:#fff;border-radius:32rpx;padding:34rpx}.close{position:absolute;right:24rpx;top:14rpx;font-size:40rpx;color:#8f7d6f}.compose-title{font-family:Georgia,serif;font-size:35rpx;font-weight:bold;margin-bottom:22rpx}.compose textarea{width:100%;min-height:160rpx;background:#f3f0e7;border-radius:16rpx;padding:15rpx;box-sizing:border-box;margin-bottom:18rpx}.photo-row{display:flex;gap:12rpx;margin-bottom:20rpx}.picked{position:relative;width:130rpx;height:130rpx;border-radius:15rpx;background:#f3f0e7;color:#927960;display:flex;align-items:center;justify-content:center;text-align:center;font-size:22rpx;overflow:hidden}.picked image{width:100%;height:100%}.picked text{position:absolute;right:5rpx;top:0;background:rgba(0,0,0,.45);color:#fff;border-radius:50%;width:30rpx;height:30rpx;text-align:center}.add{flex-direction:column;font-size:38rpx}.add view{font-size:19rpx}
