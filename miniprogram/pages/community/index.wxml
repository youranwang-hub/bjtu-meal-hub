<view class="page"><view class="community-head"><view class="eyebrow">CANTEEN NOTES</view><view class="title">大家都在吃什么？</view></view><view class="post card" wx:for="{{posts}}" wx:key="id" bindtap="detail" data-id="{{item.id}}"><view class="author"><view class="avatar">{{item.avatarLabel}}</view><view>{{item.nickname}}</view></view><view class="content">{{item.content}}</view><image wx:if="{{item.images.length}}" src="{{item.images[0]}}" mode="aspectFill" class="post-img"/><view class="post-foot"><text>{{item.createTime}}</text><view><text>{{item.liked ? '♥ 已赞' : '♡'}} {{item.likeCount}}</text><text>💬 {{item.commentCount}}</text></view></view></view><view wx:if="{{!posts.length}}" class="empty">暂无帖子，来写下第一顿饭吧</view><view class="float-add" bindtap="open">＋</view><view wx:if="{{compose}}" class="mask"><view class="compose"><view class="close" bindtap="close">×</view><view class="compose-title">写一条食堂小记</view><textarea placeholder="今天吃了什么好吃的？" maxlength="1000" value="{{content}}" bindinput="input"/><view class="photo-row"><view class="picked" wx:for="{{imagePaths}}" wx:key="*this" data-index="{{index}}" bindtap="removeImage"><image src="{{item}}" mode="aspectFill"/><text>×</text></view><view wx:if="{{imagePaths.length < 3}}" class="picked add" bindtap="photo">＋<view>添加照片</view></view></view><button class="primary-btn" loading="{{publishing}}" bindtap="publish">发布</button></view></view></view>
