width:100%;height:180rpx;background:#f3f0e7;border-radius:16rpx;padding:19rpx;margin-bottom:20rpx}.privacy-link{text-align:center;color:#9a6f40;font-size:21rpx;margin:-5rpx 0 17rpx}.feedback-history{margin-top:28rpx;border-top:1rpx solid #eee4d7}.feedback-item{position:relative;padding:15rpx 0;border-top:1rpx solid #eee4d7}.feedback-item:first-of-type{border-top:0}.feedback-status{position:absolute;right:0;top:15rpx;background:#eee4d7;color:#8b7764;border-radius:14rpx;padding:4rpx 10rpx;font-size:19rpx}.feedback-status.resolved{background:#dcebd9;color:#50805a}.feedback-content{margin-top:9rpx;line-height:1.55;white-space:pre-wrap}.feedback-reply{margin-top:14rpx;background:#f5eddf;border-radius:14rpx;padding:15rpx;color:#654c36;line-height:1.55}.feedback-reply text{display:block;font-weight:bold;color:#a16e39;margin-bottom:5rpx}
