.me-page{padding-bottom:66rpx}.profile{display:flex;align-items:center;gap:20rpx;margin-bottom:36rpx}.avatar{width:88rpx;height:88rpx;border-radius:50%;background:#b87a36;color:#fff;display:flex;align-items:center;justify-content:center;font-family:Georgia,serif;font-size:38rpx;flex:none}.avatar-leaf{background:#73956c}.avatar-tea{background:#947557}.avatar-star{background:#c5914f}.avatar-moon{background:#8291ae}.avatar-cloud{background:#8eaaa9}.avatar-seed{background:#8fa46c}.avatar-note{background:#a37877}.profile-copy{min-width:0}.name{font-size:34rpx;font-weight:bold}.profile-arrow{margin-left:auto;color:#9a744a;font-size:40rpx}.section-kicker{font-family:Georgia,serif;color:#a58b6b;font-size:19rpx;letter-spacing:3rpx;margin:28rpx 3rpx 14rpx}.entry-title{font-family:Georgia,serif;font-size:31rpx;font-weight:bold;color:#563e2c}.meal-map-card{overflow:hidden}.map-heading{display:flex;justify-content:space-between;align-items:flex-start}.map-heading .muted{margin-top:7rpx;font-size:21rpx}.map-total{text-align:right;color:#8c7058;font-size:20rpx}.map-total text{display:block;font-family:Georgia,serif;color:#b87a36;font-size:43rpx;font-weight:bold;line-height:1}.meal-map-main{display:flex;align-items:center;min-height:210rpx}.meal-map-canvas{width:210rpx;height:210rpx;flex:none}.meal-map-copy{padding-left:15rpx;color:#8b796d;font-size:23rpx;line-height:1.5}.favorite-name{font-family:Georgia,serif;color:#604832;font-weight:bold;font-size:32rpx;margin:6rpx 0;word-break:break-all}.source-legend{display:flex;flex-wrap:wrap;gap:12rpx 17rpx;padding:10rpx 0 19rpx;border-bottom:1rpx solid #eee4d7}.source-item{display:flex;align-items:center;gap:7rpx;color:#766456;font-size:22rpx}.source-item text:last-child{color:#a16d38}.source-dot{width:15rpx;height:15rpx;border-radius:50%;display:inline-block}.canteen-frequency{padding-top:18rpx}.frequency-row{display:flex;align-items:center;gap:12rpx;margin-top:14rpx;color:#6a513c;font-size:23rpx}.frequency-row>text:first-child{width:145