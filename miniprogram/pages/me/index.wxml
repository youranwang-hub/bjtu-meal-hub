<view class="page me-page">
  <block wx:if="{{user}}">
    <view class="card profile" bindtap="openProfile"><view class="avatar avatar-{{user.avatarId}}">{{user.avatarLabel}}</view><view class="profile-copy"><view class="name">{{user.nickname}}</view><view class="muted">小食叙记 · 已积累 {{user.points}} 分</view></view><text class="profile-arrow">›</text></view>

    <view class="section-kicker">MY FOOD JOURNAL</view>
    <view class="card meal-map-card"><view class="map-heading"><view><view class="entry-title">{{mealMap.monthLabel}}吃饭地图</view><view class="muted">你的每一顿，正在变成自己的饮食足迹。</view></view><view class="map-total"><text>{{mealMap.total}}</text><view>本月打卡</view></view></view><view class="meal-map-main"><canvas canvas-id="mealMap" class="meal-map-canvas" width="300" height="300"></canvas><view class="meal-map-copy"><view wx:if="{{mealMap.favoriteCanteen}}">最常去</view><view wx:if="{{mealMap.favoriteCanteen}}" class="favorite-name">{{mealMap.favoriteCanteen}}</view><view wx:else class="favorite-name">等待第一顿饭</view><view class="muted">{{mealMap.favoriteCanteen ? '本月最常出现的食堂' : '打卡后会生成你的饮食足迹'}}</view></view></view><view wx:if="{{mealMap.sourceStats.length}}" class="source-legend"><view wx:for="{{mealMap.sourceStats}}" wx:key="key" class="source-item"><text class="source-dot" style="background: {{item.color}}"></text><text>{{item.label}}</text><text>{{item.count}} 顿</text></view></view><view wx:if="{{mealMap.canteenStats.length}}" class="canteen-frequency"><view class="muted">食堂就餐频率</view><view wx:for="{{mealMap.canteenStats}}" wx:key="name" class="frequency-row"><text>{{item.name}}</text><view><view class="frequency-track"><view class="frequency-fill" style="width: {{item.count / mealMap.total * 100}}%"></view></view></view><text>{{item.count}} 次</text></view></view></view>

    <view class="section-kicker">MY CORNER</view>
    <view class="quick-grid">
      <view class="quick-card" bindtap="openDetail" data-type="interactions"><view class="quick-mark">互</view><view><view class="quick-title">收到的互动 <text wx:if="{{unreadFeedbackCount}}" class="quick-badge">{{unreadFeedbackCount}}</text></view><view class="muted">{{likes.length + notifications.length ? '赞和评论都在这里' : '还没有新的互动'}}</view></view><text>›</text></view>
      <view class="quick-card" bindtap="openDetail" data-type="badges"><view class="quick-mark">章</view><view><view class="quick-title">我的小徽章</view><view class="muted">已获得 {{badges.length}} 枚</view></view><text>›</text></view>
      <view class="quick-card" bindtap="openDetail" data-type="contributions"><view class="quick-mark">投</view><view><view class="quick-title">我的投稿</view><view class="muted">{{photos.length}} 张实拍 · {{reports.length}} 条情报</view></view><text>›</text></view>
      <view class="quick-card" bindtap="openFeedback"><view class="quick-mark">信</view><view><view class="quick-title">和饭搭子说说</view><view class="muted">建议、问题，或任何想说的话</view></view><text>›</text></view>
    </view>
    <view wx:if="{{user && user.isAdmin}}" class="admin-entry" bindtap="admin"><view><view>管理员工作台</view><view class="muted">管理菜品、内容、审核与来信</view></view><text>›</text></view>
    <view class="privacy-entry" bindtap="privacy"><view><view>隐私与权限说明</view><view class="muted">账号、相册、相机和地图如何被使用</view></view><text>›</text></view>
    <button class="logout" bindtap="logout">退出登录</button>
  </block>
  <view wx:else class="card logged-out"><view class="entry-title">把每一顿饭写进生活里</view><view class="muted">登录后记录打卡、投稿和自己的小食足迹。</view><button class="primary-btn" bindtap="login">微信一键登录</button></view>

  <view wx:if="{{detailOpen}}" class="detail-mask"><view class="detail-panel"><view class="detail-close" bindtap="closeDetail">×</view>
    <block wx:if="{{detailType === 'interactions'}}"><view class="detail-title">收到的互动</view><view wx:if="{{likes.length || notifications.length}}"><view wx:for="{{likes}}" wx:key="post_id" class="detail-item" bindtap="goPost" data-postid="{{item.post_id}}"><view class="detail-mark">赞</view><view><text class="notice-name">{{item.nickname}}</text> 赞了你的帖子<view class="muted">{{item.content}}</view></view></view><view wx:for="{{notifications}}" wx:key="comment_id" class="detail-item" bindtap="goPost" data-postid="{{item.post_id}}" data-commentid="{{item.comment_id}}"><view class="detail-mark">评</view><view><text class="notice-name">{{item.nickname}}</text> 评论了你<view class="muted">{{item.content}}</view></view></view></view><view wx:else class="detail-empty">先去社区逛逛，互动会在这里出现。</view></block>
    <block wx:if="{{detailType === 'badges'}}"><view class="detail-title">我的小徽章</view><view wx:if="{{badges.length}}" class="badge-list"><view wx:for="{{badges}}" wx:key="id" class="badge"><view class="badge-mark">{{item.mark}}</view><view><view class="badge-name">{{item.name}}</view><view class="muted">{{item.description}}</view></view></view></view><view wx:else class="detail-empty">从完成第一顿打卡开始，收集属于你的小徽章。</view></block>
    <block wx:if="{{detailType === 'contributions'}}"><view class="detail-title">我的投稿</view><view class="sub-title">实拍图</view><view wx:if="{{photos.length}}"><view wx:for="{{photos}}" wx:key="id" class="history"><view>{{item.dish_name}}</view><text>{{item.status === 'pending' ? '审核中' : item.status === 'approve' ? '已通过' : '未通过'}}</text></view></view><view wx:else class="detail-empty compact">还没有实拍投稿。</view><view class="sub-title">上新情报</view><view wx:if="{{reports.length}}"><view wx:for="{{reports}}" wx:key="id" class="history"><view>{{item.dish_name}}</view><text>{{item.status === 'pending' ? '整理中' : item.status === 'approve' ? '已收录' : '未收录'}}</text></view></view><view wx:else class="detail-empty compact">还没有提交上新情报。</view></block>
  </view></view>

  <view wx:if="{{profileOpen}}" class="profile-mask"><view class="profile-panel"><view class="profile-close" bindtap="closeProfile">×</view><view class="section-kicker">YOUR FOOD IDENTITY</view><view class="profile-title">我的小食身份</view><view class="muted">只在小食叙记中展示，不关联微信昵称和头像。</view><input class="profile-input" maxlength="16" value="{{profileNickname}}" placeholder="给自己取个昵称" bindinput="profileInput"/><view class="profile-avatar-grid"><view wx:for="{{avatars}}" wx:key="id" class="profile-avatar-choice {{profileAvatarId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="chooseAvatar">{{item.label}}</view></view><button class="primary-btn" loading="{{profileSaving}}" bindtap="saveProfile">保存</button></view></view>
  <view wx:if="{{feedbackOpen}}" class="feedback-mask"><view class="feedback-panel"><view class="feedback-close" bindtap="closeFeedback">×</view><view class="section-kicker">LETTER TO FOOD PAL</view><view class="feedback-panel-title">和饭搭子说说</view><view class="muted">你的每一条想法，都会帮助这里变得更好。</view><picker range="{{feedbackTypes}}" value="{{feedbackTypeIndex}}" bindchange="feedbackTypeChange"><view class="feedback-picker">{{feedbackType}} <text>⌄</text></view></picker><textarea maxlength="1000" placeholder="想说什么？我们在认真听。" value="{{feedbackContent}}" bindinput="feedbackInput"/><view class="privacy-link" bindtap="privacy">提交即表示你已阅读《隐私与权限说明》</view><button class="primary-btn" loading="{{feedbackSending}}" bindtap="submitFeedback">寄出这封信</button><view wx:if="{{feedbacks.length}}" class="feedback-history"><view class="sub-title">我写的信</view><view wx:for="{{feedbacks}}" wx:key="id" class="feedback-item" data-id="{{item.id}}" bindtap="readFeedback"><view class="feedback-status {{item.status === 'resolved' ? 'resolved' : ''}}">{{item.hasUnreadReply ? '新回复' : item.status === 'resolved' ? '已回复' : '已收到'}}</view><view class="muted">{{item.feedback_type}} · {{item.createTime}}</view><view class="feedback-content">{{item.content}}</view><view wx:if="{{item.reply}}" class="feedback-reply"><text>饭搭子回复</text><view>{{item.reply}}</view></view></view></view></view></view>
</view>
