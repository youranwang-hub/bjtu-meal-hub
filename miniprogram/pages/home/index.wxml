<view class="page">
  <view class="topline"><view><view class="eyebrow">TODAY'S MEAL NOTE</view><view class="hello">好好吃饭，<text>今天也是。</text></view><view class="date">{{today}}</view></view><view class="avatar">饭</view></view>
  <view class="search" bindtap="search"><image class="home-icon" src="/assets/icon-search.svg" mode="aspectFit"/> 搜索一道想吃的菜</view>
  <view wx:if="{{searchOpen}}" class="search-layer"><view class="search-panel"><view class="search-input"><image class="search-panel-icon" src="/assets/icon-search.svg" mode="aspectFit"/><input focus placeholder="搜菜品或档口" value="{{query}}" bindinput="searchInput"/><text bindtap="closeSearch">取消</text></view><view wx:if="{{query && !searchResults.length}}" class="search-empty">没有找到，换个关键词试试？</view><view class="result" wx:for="{{searchResults}}" wx:key="id" bindtap="dish" data-id="{{item.id}}"><view><view class="result-name">{{item.name}}</view><view class="muted">{{item.canteenName}} · {{item.stallName}}</view></view><view class="result-price">¥{{item.specialPrice || item.price}}</view></view></view></view>
  <view class="section-head"><view class="section-title">食堂在这里</view><view class="map-hint">可拖动浏览</view></view>
  <view class="map-card"><map class="campus-map" latitude="{{mapCenter.latitude}}" longitude="{{mapCenter.longitude}}" scale="{{mapScale}}" markers="{{mapMarkers}}" enable-scroll="{{true}}" enable-zoom="{{true}}" show-location="{{false}}" bindmarkertap="mapMarkerTap"></map></view>
  <view wx:if="{{selectedBuilding}}" class="building-mask"><view class="building-sheet"><view class="sheet-close" bindtap="closeBuilding">×</view><view wx:if="{{selectedBuilding.isCollecting}}" class="eyebrow">COLLECTING INFO</view><view wx:else class="eyebrow">CHOOSE A FLOOR</view><view class="building-title">{{selectedBuilding.name}}</view><view class="muted">{{selectedBuilding.crowdHint}} · {{selectedBuilding.crowdStatus}}</view><block wx:if="{{selectedBuilding.isCollecting}}"><view class="collecting"><view>这里的楼层、档口和菜品正在整理中。</view><view class="muted">你知道什么新菜？欢迎告诉我们。</view><button size="mini" data-canteen="{{selectedBuilding.name}}" bindtap="openReport">提交上新情报</button></view></block><block wx:else><view class="restaurant-choice" wx:for="{{selectedBuilding.restaurants}}" wx:key="id" bindtap="canteen" data-id="{{item.id}}"><view><view>{{item.name}}</view><view class="muted">{{item.floor || '餐厅'}}</view></view><text>›</text></view></block></view></view>
  <view class="intel-card" bindtap="openReport"><view class="intel-icon"><image src="/assets/icon-report.svg" mode="aspectFit"/></view><view><view class="intel-title">食堂情报站</view><view class="muted">发现菜品上新，我要报告！</view></view><text>›</text></view>
  <view class="section-head"><view class="section-title">今日推荐</view><view class="map-hint">为你挑选</view></view>
  <scroll-view scroll-x class="horizontal"><view class="dish-row"><view class="dish-card" wx:for="{{recommended}}" wx:key="id" bindtap="dish" data-id="{{item.id}}"><view class="photo-wrap"><image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill"/><view wx:else class="no-photo">暂无实拍图</view><view wx:if="{{item.isNew}}" class="new">NEW</view></view><view class="dish-name">{{item.name}}</view><view class="muted">{{item.stallName}}</view><view><text class="price">¥{{item.specialPrice || item.price}}</text><text wx:if="{{item.rating}}" class="rating">★ {{item.rating}}</text></view></view></view></scroll-view>
  <view class="section-head"><view class="section-title">特价菜品</view><view wx:if="{{specialDishes.length}}" class="map-hint" bindtap="specials">查看全部 ›</view><view wx:else class="map-hint">今日待上新</view></view><view wx:if="{{specialDishes.length}}" class="special-grid"><view class="special-mini" wx:for="{{specialDishes}}" wx:key="id" bindtap="dish" data-id="{{item.id}}"><image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill"/><view wx:else class="special-empty">特</view><view class="special-name">{{item.name}}</view><view><text class="old">¥{{item.price}}</text><text class="price">¥{{item.specialPrice}}</text></view></view></view><view wx:else class="special-wait">🏷️ 暂无特价菜品，等食堂老板放出今日惊喜。</view>
  <view class="section-head"><view class="section-title">食堂一览</view><view class="map-hint">点点看 ›</view></view><view class="canteen-grid"><view wx:for="{{canteenBuildings}}" wx:key="id" class="canteen-mini" wx:if="{{item.restaurants.length}}" bindtap="canteen" data-id="{{item.restaurants[0].id}}"><view>{{item.name}}</view><text>{{item.restaurants.length}} 个餐区</text><text class="crowd-dot crowd-{{item.statusClass}}"></text></view><view wx:for="{{canteenBuildings}}" wx:key="id" class="canteen-mini collecting-mini" wx:if="{{!item.restaurants.length}}" bindtap="openReport" data-canteen="{{item.name}}"><view>{{item.name}}</view><text>资料筹备中</text></view></view>
  <view wx:if="{{reportOpen}}" class="modal-mask"><view class="report-card"><view class="report-close" bindtap="closeReport">×</view><view class="eyebrow">CANTEEN INTELLIGENCE</view><view class="report-title">发现上新？告诉我们</view><view class="muted">审核通过后，它会成为大家的“新菜”</view><input placeholder="食堂名称（选填）" value="{{report.canteenName}}" data-key="canteenName" bindinput="reportInput"/><input placeholder="档口名称（选填）" value="{{report.stallName}}" data-key="stallName" bindinput="reportInput"/><input placeholder="新菜叫什么？" value="{{report.dishName}}" data-key="dishName" bindinput="reportInput"/><button class="primary-btn" bindtap="submitReport">把情报送出去</button></view></view>
</view>
