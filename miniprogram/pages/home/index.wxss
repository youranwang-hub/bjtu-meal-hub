.topline{display:flex;justify-content:space-between;align-items:flex-start;padding:10rpx 4rpx 28rpx}.eyebrow{font-family:Georgia,serif;font-size:18rpx;letter-spacing:2rpx;color:#a78a68}.hello{font-family:Georgia,serif;font-size:43rpx;font-weight:bold;margin-top:8rpx}.hello text{color:#b87a36}.date{font-family:Georgia,serif;color:#8d7b70;margin-top:8rpx;font-size:23rpx}.avatar{width:66rpx;height:66rpx;border:2rpx solid #d6c7b5;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#a3703f;font-family:Georgia,serif}.search{background:rgba(255,255,255,.8);border:2rpx solid rgba(132,105,77,.12);color:#9a8e87;padding:21rpx 28rpx;border-radius:40rpx;box-shadow:0 8rpx 16rpx rgba(91,69,44,.04)}.search text{font-size:36rpx;color:#6e5744;margin-right:10rpx}.section-head{display:flex;align-items:baseline;justify-content:space-between}.map-hint{font-size:22rpx;color:#a58261}.map-card{position:relative;height:382rpx;border-radius:30rpx;overflow:hidden;box-shadow:0 12rpx 30rpx rgba(91,69,44,.08)}.map-card image{width:100%;height:100%}.map-copy{position:absolute;top:23rpx;left:24rpx;font-family:Georgia,serif;font-size:30rpx;font-weight:bold;color:#614935}.map-copy text{display:block;font-family:"PingFang SC";font-size:20rpx;font-weight:normal;margin-top:5rpx;color:#8b796d}.map-chips{position:absolute;left:19rpx;right:19rpx;bottom:17rpx;display:flex;gap:10rpx;overflow:hidden}.map-chips view{white-space:nowrap;background:rgba(255,255,255,.88);border-radius:22rpx;padding:10rpx 15rpx;color:#634b36;font-size:20rpx}.horizontal{white-space:nowrap;width:calc(100% + 28rpx)}.dish-row{display:flex;gap:19rpx;padding-right:28rpx}.dish-card{width:250rpx;display:inline-block;white-space:normal}.photo-wrap{width:250rpx;height:205rpx;border-radius:27rpx;overflow:hidden;background:#eae5da;position:relative}.photo-wrap image{width:100%;height:100%}.no-photo{height:100%;display:flex;align-items:center;justify-content:center;color:#9b8f81;font-size:23rpx}.new{position:absolute;top:13rpx;left:13rpx;background:#b87a36;color:#fff;border-radius:18rpx;padding:5rpx 10rpx;font-family:Georgia,serif;font-size:17rpx}.dish-name{font-weight:700;margin:13rpx 0 4rpx}.price{color:#ad6c2e;font-weight:700;font-size:29rpx;line-height:46rpx}.rating{float:right;font-size:21rpx;color:#a88c54;line-height:48rpx}.special{display:flex;justify-content:space-between;min-height:160rpx;overflow:hidden}.special-name{font-family:Georgia,serif;font-size:36rpx;font-weight:bold;margin:9rpx 0}.special image{width:180rpx;height:180rpx;border-radius:50%;margin:-12rpx -12rpx -18rpx 10rpx}
.intel-card{display:flex;align-items:center;gap:17rpx;background:#e3d1a9;border-radius:25rpx;padding:19rpx 23rpx;margin-top:18rpx;color:#604832}.intel-icon{width:52rpx;height:52rpx;border-radius:50%;background:rgba(255,255,255,.65);display:flex;align-items:center;justify-content:center;font-size:27rpx}.intel-title{font-family:Georgia,serif;font-weight:bold;font-size:28rpx}.intel-card>text{margin-left:auto;font-size:38rpx}.search-layer,.modal-mask{position:fixed;z-index:100;left:0;right:0;top:0;bottom:0;background:rgba(65,52,44,.24)}.search-panel{position:absolute;left:0;right:0;top:0;min-height:100vh;background:#f3f0e7;padding:130rpx 28rpx 40rpx}.search-input{height:76rpx;border-radius:42rpx;background:#fff;display:flex;align-items:center;padding:0 23rpx;gap:15rpx}.search-input input{flex:1}.search-input text:first-child{font-size:34rpx}.search-input text:last-child{color:#a36c33;font-size:23rpx}.result{padding:24rpx 9rpx;border-bottom:1rpx solid #ddd3c5;display:flex;align-items:center;justify-content:space-between}.result-name{font-weight:bold;font-size:30rpx;margin-bottom:7rpx}.result-price{color:#ae7134;font-family:Georgia,serif;font-size:29rpx}.search-empty{text-align:center;color:#95857b;margin-top:75rpx}.report-card{position:absolute;left:34rpx;right:34rpx;top:50%;transform:translateY(-50%);background:#fff;border-radius:34rpx;padding:40rpx 31rpx}.report-close{position:absolute;right:24rpx;top:15rpx;font-size:42rpx;color:#8e7b6b}.report-title{font-family:Georgia,serif;font-size:38rpx;font-weight:bold;margin:12rpx 0 7rpx}.report-card input{background:#f3f0e7;border-radius:14rpx;padding:20rpx;margin-top:17rpx;font-size:25rpx}.report-card button{margin-top:25rpx}
.special-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16rpx}.special-mini{background:#fff;border-radius:24rpx;padding:14rpx;min-height:150rpx;box-shadow:0 8rpx 18rpx rgba(90,65,40,.06)}.special-mini image{width:100%;height:120rpx;border-radius:17rpx}.special-empty{height:120rpx;background:#e9dcc7;color:#b87a36;border-radius:17rpx;display:flex;align-items:center;justify-content:center;font-family:Georgia,serif;font-size:42rpx}.special-mini .special-name{font-weight:bold;font-size:25rpx;margin:10rpx 0 3rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.old{color:#9b8b7e;text-decoration:line-through;font-size:20rpx;margin-right:9rpx}.canteen-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12rpx}.canteen-mini{position:relative;background:rgba(255,255,255,.76);border-radius:17rpx;padding:19rpx 18rpx;color:#574233;font-weight:600;font-size:25rpx}.canteen-mini>text:nth-child(2){font-weight:normal;color:#978476;font-size:20rpx;margin-left:9rpx}.crowd-dot{position:absolute;right:14rpx;top:14rpx;width:11rpx;height:11rpx;border-radius:50%;background:#b8a995}
