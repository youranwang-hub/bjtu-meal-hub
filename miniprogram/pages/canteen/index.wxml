<view class="page" wx:if="{{canteen}}">
  <view class="card"><view class="title">{{canteen.name}} {{canteen.floor}}</view><view class="muted">{{canteen.descriptionText}}</view><view class="crowd-summary"><text class="crowd-status">{{canteen.crowdStatus}}</text><text>{{canteen.crowdHint}}</text><text class="crowd-help" bindtap="toggleCrowdExplain">?</text></view><view wx:if="{{crowdExplain}}" class="crowd-explain">人流来自同学主动报送：仅汇总近 90 分钟的数据。空闲、适中、拥挤分别按 1、2、3 计分后取平均；没有报送时不会进行推测。{{canteen.crowdUpdatedAt ? ' 最近更新：北京时间 ' + canteen.crowdUpdatedAt : ''}}</view></view>
  <view wx:if="{{crowdPrompt}}" class="crowd-ask"><view class="ask-title">你现在在这个食堂吗？</view><view class="muted">人多不多？你的回答会汇总成近 90 分钟的人流提示。</view><view class="crowd-options"><button loading="{{crowdSending}}" data-level="1" bindtap="reportCrowd">😌 空闲</button><button loading="{{crowdSending}}" data-level="2" bindtap="reportCrowd">🙂 适中</button><button loading="{{crowdSending}}" data-level="3" bindtap="reportCrowd">😵 拥挤</button></view><view class="not-here" bindtap="notHere">我不在这里</view></view>
  <view class="section-title">档口</view><view class="card" wx:for="{{canteen.stalls}}" wx:key="id" bindtap="stalls" data-id="{{item.id}}"><view class="title">{{item.name}} <text class="muted">{{item.dish_count}} 道菜</text></view><view class="muted">{{item.locationText}} · {{item.openTimeText}}</view></view>
  <view wx:if="{{dishes.length}}" class="section-title">菜品</view><view class="card" wx:for="{{dishes}}" wx:key="id" bindtap="dish" data-id="{{item.id}}">{{item.name}} <text class="price">¥{{item.price}}</text></view>
</view>
