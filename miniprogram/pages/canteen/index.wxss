.title{font-size:32rpx;font-weight:700}.price{float:right;color:#b87a36}.crowd-summary{display:flex;align-items:center;gap:14rpx;margin-top:18rpx;font-size:23rpx;color:#867266}.crowd-status{background:#ebd8b1;color:#7a5736;border-radius:18rpx;padding:7rpx 14rpx;font-weight:600}.crowd-help{width:31rpx;height:31rpx;line-height:31rpx;text-align:center;border:1rpx solid #c9b397;border-radius:50%;color:#9b7147}.crowd-explain{margin-top:17rpx;padding:18rpx;background:#f7f1e5;border-radius:16rpx;color:#786656;font-size:21rpx;line-height:1.65}.crowd-ask{background:#e5d1a8;border-radius:28rpx;padding:27rpx 25rpx;margin:24rpx 0;color:#604832}.ask-title{font-family:Georgia,serif;font-size:32rpx;font-weight:bold;margin-bottom:8rpx}.crowd-options{display:flex;gap:10rpx;margin-top:22rpx}.crowd-options button{flex:1;padding:15rpx 4rpx;font-size:22rpx;border-radius:19rpx;background:rgba(255,255,255,.72);color:#614832}.not-here{text-align:center;font-size:23rpx;color:#92775d;margin-top:20rpx}
