.check-head{text-align:center;padding:25rpx 0 32rpx}.eyebrow{font-family:Georgia,serif;font-size:19rpx;color:#a58b6b;letter-spacing:3rpx}.journal-title{font-family:Georgia,serif;font-weight:bold;font-size:47rpx;margin:11rpx 0}.date{font-family:Georgia,serif;color:#83756b;font-size:25rpx}.calendar-card{background:rgba(255,255,255,.91);border-radius:34rpx;padding:30rpx 23rpx;box-shadow:0 12rpx 30rpx rgba(91,69,44,.07)}.month-nav{display:flex;align-items:center;justify-content:space-between;margin-bottom:28rpx}.month-nav>text{width:48rpx;height:48rpx;line-height:44rpx;text-align:center;border-radius:50%;background:#f1eee7;color:#9b6d3f;font-size:46rpx}.month{text-align:center;font-family:Georgia,serif;font-weight:bold;font-size:33rpx}.week,.days{display:grid;grid-template-columns:repeat(7,1fr);gap:11rpx}.week text{text-align:center;color:#918277;font-family:Georgia,serif;font-size:21rpx}.day{height:68rpx;border-radius:20rpx;background:#f1eee7;display:flex;align-items:center;justify-content:center;position:relative;font-family:Georgia,serif}.day.blank{background:transparent}.day.today{background:#bd8a48;color:#fff}.day.selected{outline:3rpx solid #b47a37;outline-offset:2rpx}.meal-dot{position:absolute;right:-5rpx;top:-7rpx;width:27rpx;height:27rpx;border-radius:50%;background:#725339;color:#fff;font-size:17rpx;display:flex;align-items:center;justify-content:center}.meal-quote{font-family:Georgia,serif;color:#806d5e;line-height:1.6}.meals{display:flex;gap:14rpx;margin-top:25rpx}.meal,.done{flex:1;height:108rpx;font-size:21rpx;line-height:1.6;padding:10rpx}.meal text,.done text{font-family:Georgia,serif;font-size:35rpx}.meal{background:#f0ece3;color:#806447}.done{background:#bd8a48;color:#fff}.daily-history{margin-top:24rpx;padding-top:20rpx;border-top:1rpx solid #e9dfd1}.daily-history-title{font-weight:bold;color:#6a5038;margin-bottom:12rpx}.daily-record{display:flex;gap:16rpx;padding:13rpx 0;border-top:1rpx solid #f0e8dc;color:#604b39}.daily-record>text{background:#ead6af;color:#805a35;border-radius:14rpx;padding:5rpx 11rpx;height:max-content;font-size:21rpx}.daily-record .muted{font-size:20rpx;margin-top:4rpx}.daily-empty{padding:16rpx 0 2rpx;color:#9a8879;font-size:23rpx}.rank{display:flex;align-items:center;gap:20rpx;padding:21rpx 26rpx;margin-bottom:14rpx}.rank-no{font-family:Georgia,serif;color:#bd8a48;font-weight:bold}.points{margin-left:auto;color:#aa7135;font-family:Georgia,serif}
.meal-mask{position:fixed;z-index:80;inset:0;background:rgba(65,52,44,.28)}.meal-confirm{position:absolute;left:38rpx;right:38rpx;top:50%;transform:translateY(-50%);background:#fff;border-radius:38rpx;padding:46rpx 33rpx;text-align:center}.tiny-bowl{width:75rpx;height:75rpx;display:flex;align-items:center;justify-content:center;margin:0 auto 12rpx;border-radius:50%;background:#ead7b0;font-size:39rpx}.confirm-title{font-family:Georgia,serif;font-size:39rpx;font-weight:bold}.confirm-copy{color:#847367;margin:13rpx 0 29rpx}.later{font-size:24rpx;color:#9b897b;margin-top:24rpx}.celebrate{position:fixed;z-index:100;left:50%;top:45%;transform:translate(-50%,-50%);width:390rpx;background:rgba(80,61,43,.94);color:#fff;border-radius:26rpx;padding:30rpx;text-align:center;box-shadow:0 12rpx 34rpx rgba(40,25,10,.25)}.celebrate-bowl{font-size:43rpx;margin-bottom:8rpx}.celebrate button{margin-top:18rpx;background:#f0d198;color:#62452d;border-radius:20rpx;font-size:22rpx}
.source-row{display:flex;align-items:center;justify-content:space-between;background:#f4f0e8;border-radius:18rpx;padding:17rpx 19rpx;margin:20rpx 0 14rpx;color:#665548;font-size:25rpx}.source-picker{color:#a56e31;font-weight:600}.source-picker text{margin-left:8rpx}.meal-input{box-sizing:border-box;width:100%;height:82rpx;background:#f4f0e8;border:2rpx solid #e3d7c5;border-radius:18rpx;padding:0 21rpx;margin-bottom:13rpx;font-size:26rpx}.result,.chosen{display:flex;justify-content:space-between;align-items:center;text-align:left;border-radius:15rpx;padding:15rpx 19rpx;margin-bottom:10rpx;background:#fbf8f2;color:#5d4938;font-size:25rpx}.result text{color:#a56e31}.chosen{background:#f0dfbf;color:#745330}
