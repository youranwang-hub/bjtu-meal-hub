<view class="page">
  <view class="check-head"><view class="eyebrow">MY FOOD JOURNAL</view><view class="journal-title">今天，吃得好吗？</view><view class="date">{{todayLabel}}</view></view>
  <view class="calendar-card"><view class="month-nav"><text data-step="-1" bindtap="changeMonth">‹</text><view class="month">{{monthLabel}}</view><text data-step="1" bindtap="changeMonth">›</text></view><view class="week"><text>日</text><text>一</text><text>二</text><text>三</text><text>四</text><text>五</text><text>六</text></view><view class="days"><view wx:for="{{calendar}}" wx:key="index" class="day {{item.blank ? 'blank' : ''}} {{item.isToday ? 'today' : ''}} {{item.isSelected ? 'selected' : ''}}" data-date="{{item.date}}" bindtap="selectDate"><text wx:if="{{!item.blank}}">{{item.day}}</text><view wx:if="{{item.mealCount}}" class="meal-dot">{{item.mealCount}}</view></view></view></view>
  <view class="section-title">今天的三餐</view>
  <view class="meal-card card"><view class="meal-quote">每一顿认真吃的饭，都会变成生活的底气。</view><view class="meals"><button wx:for="{{meals}}" wx:key="key" class="{{item.done ? 'done' : 'meal'}}" data-meal="{{item.key}}" bindtap="chooseMeal"><text>{{item.done ? '✓' : item.short}}</text><view>{{item.label}}</view></button></view><view wx:if="{{selectedDate}}" class="daily-history"><view class="daily-history-title">{{selectedDateLabel}} 的饮食记录</view><view wx:if="{{selectedRecords.length}}"><view wx:for="{{selectedRecords}}" wx:key="mealType" class="daily-record"><text>{{item.mealLabel}}</text><view><view>{{item.dishText}}</view><view class="muted">北京时间 {{item.checkinTime}}</view></view></view></view><view wx:else class="daily-empty">这一天还没有留下饮食记录。</view></view></view>
  <view class="section-head"><view class="section-title">本周食客榜</view></view>
  <view class="rank card" wx:for="{{topLeaderboard}}" wx:key="index"><text class="rank-no">0{{index+1}}</text><text>{{item.nickname}}</text><text class="points">{{item.checkin_points}} 分</text></view>
  <view wx:if="{{pendingMeal}}" class="meal-mask"><view class="meal-confirm"><view class="tiny-bowl">🍚</view><view class="confirm-title">{{pendingMeal.label}}时间</view><view class="confirm-copy">{{pendingMeal.warm}}</view>
    <view class="source-row"><text>这一餐来自</text><picker range="{{sourceOptions}}" value="{{sourceIndex}}" bindchange="changeSource"><view class="source-picker">{{source}} <text>⌄</text></view></picker></view>
    <view wx:if="{{source === '食堂'}}"><input class="meal-input" placeholder="搜索食堂菜品，例如：鸡腿饭" value="{{dishQuery}}" bindinput="dishInput"/><view class="result" wx:for="{{dishResults}}" wx:key="id" data-dish="{{item}}" bindtap="selectDish">{{item.name}} <text>¥{{item.price}}</text></view><view class="chosen" wx:for="{{selectedDishes}}" wx:key="id" data-id="{{item.id}}" bindtap="removeDish">{{item.name}} ×</view></view>
    <view wx:else><input class="meal-input" placeholder="{{sourceHint}}" value="{{customDish}}" bindinput="customInput"/></view>
    <button class="primary-btn" bindtap="checkin">好好收下这顿饭</button><view class="later" bindtap="closeMeal">再想想</view>
  </view></view>
  <view wx:if="{{celebrate}}" class="celebrate"><view class="celebrate-bowl">🍚</view><view>{{celebrate}}已收进今天的日历</view><button size="mini" bindtap="addPhotoAfterCheckin">📷 拍照留念</button></view>
</view>
