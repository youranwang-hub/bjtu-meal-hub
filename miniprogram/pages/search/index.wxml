<view class="page"><view class="search-bar"><input placeholder="输入菜品或档口" value="{{q}}" bindinput="input" confirm-type="search" bindconfirm="search"/><button size="mini" bindtap="search">搜索</button></view><view class="card" wx:for="{{dishes}}" wx:key="id" bindtap="dish" data-id="{{item.id}}"><view class="name">{{item.name}} <text class="price">¥{{item.price}}</text></view><view class="muted">{{item.canteenName}} · {{item.stallName}}</view></view><view wx:if="{{q && !dishes.length}}" class="empty">暂无匹配菜品</view></view>
