.head{text-align:center;padding:18rpx 0 28rpx}.eyebrow{font-family:Georgia,serif;letter-spacing:3rpx;color:#a58b6b;font-size:19rpx}.title{font-family:Georgia,serif;font-size:42rpx;font-weight:bold;margin-top:8rpx}.stat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12rpx}.stat{background:#fff;border-radius:20rpx;padding:19rpx 4rpx;text-align:center;color:#887568;font-size:21rpx}.stat text{display:block;font-family:Georgia,serif;color:#a96f32;font-size:34rpx;font-weight:bold}.search{background:#fff;border-radius:20rpx;padding:11rpx;display:flex;gap:10rpx}.search input{flex:1;padding:10rpx}.search button{background:#b87a36;color:#fff;border-radius:20rpx}.dish,.content{display:flex;justify-content:space-between;align-items:center;padding:20rpx 24rpx}.dish>text{color:#ae7134;font-family:Georgia,serif}.content>text{color:#b65e4c;font-size:23rpx;margin-left:16rpx}.mask{position:fixed;z-index:100;inset:0;background:rgba(65,52,44,.3)}.editor{position:absolute;left:44rpx;right:44rpx;top:50%;transform:translateY(-50%);background:#fff;border-radius:30rpx;padding:35rpx}.editor-title{font-family:Georgia,serif;font-size:32rpx;font-weight:bold;margin-bottom:24rpx}.editor input{background:#f3f0e7;border-radius:14rpx;padding:21rpx;margin-bottom:20rpx}.cancel{text-align:center;color:#8e7d6e;margin-top:23rpx}
.review{display:flex;gap:18rpx}.review image{width:150rpx;height:150rpx;border-radius:15rpx;background:#eee}.review button{margin:12rpx 8rpx 0 0;background:#b87a36;color:#fff;border-radius:16rpx;font-size:20rpx}.review .reject,.delete{background:#eee;color:#9a5a4a}.content>view:last-child text{margin-left:14rpx;color:#a67538;font-size:22rpx}.content>view:last-child .delete{color:#b65e4c}
.editor-label{font-size:23rpx;color:#876f5c;margin:10rpx 0 8rpx}.special-btn{background:#d9af5d;color:#fff;border-radius:28rpx;margin-top:3rpx}.clear-btn{margin-top:14rpx;background:#f1ebe1;color:#9b6543;border-radius:28rpx}
.empty-special{background:rgba(255,255,255,.72);border:2rpx dashed #dfc9a7;border-radius:20rpx;color:#92755a;font-size:24rpx;padding:25rpx;text-align:center}.special-actions{display:flex;align-items:center;gap:12rpx}.special-actions>text{color:#ae7134;font-family:Georgia,serif;font-weight:bold}.special-actions button,.feedback button{margin:0;background:#f0e5d2;color:#956333;border-radius:18rpx;font-size:20rpx}.feedback{display:flex;align-items:center;justify-content:space-between;gap:15rpx}.feedback-body{width:100%}.feedback-meta{font-weight:bold;color:#815b38;margin-bottom:8rpx}.feedback-content{line-height:1.55;margin-bottom:8rpx;white-space:pre-wrap}.feedback textarea{box-sizing:border-box;width:100%;height:110rpx;background:#f5f1e8;border-radius:14rpx;padding:14rpx;font-size:22rpx;margin-top:15rpx}.feedback button{margin-top:12rpx}
.empty-special{background:rgba(255,255,255,.72);border:2rpx dashed #dfc9a7;border-radius:20rpx;color:#92755a;font-size:24rpx;padding:25rpx;text-align:center}.special-actions{display:flex;align-items:center;gap:12rpx}.special-actions>text{color:#ae7134;font-family:Georgia,serif;font-weight:bold}.special-actions button,.feedback button{margin:0;background:#f0e5d2;color:#956333;border-radius:18rpx;font-size:20rpx}.feedback{display:flex;align-items:center;justify-content:space-between;gap:15rpx}.feedback-body{width:100%}.feedback-meta{font-weight:bold;color:#815b38;margin-bottom:8rpx}.feedback-content{line-height:1.55;margin-bottom:8rpx;white-space:pre-wrap}.feedback textarea{box-sizing:border-box;width:100%;height:110rpx;background:#f5f1e8;border-radius:14rpx;padding:14rpx;font-size:22rpx;margin-top:15rpx}.feedback button{margin-top:12rpx}.report-review{margin-bottom:14rpx}.report-actions{display:flex;gap:12rpx;margin-top:14rpx}.report-actions button{margin:0;background:#f0e5d2;color:#956333;border-radius:18rpx;font-size:20rpx}.report-actions .reject{background:#eee;color:#9a5a4a}
