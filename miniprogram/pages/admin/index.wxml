<view class="page">
  <view class="head"><view class="eyebrow">ADMIN DESK</view><view class="title">管理员工作台</view></view>
  <view class="stat-grid"><view class="stat" wx:for="{{statItems}}" wx:key="label"><text>{{item.value || 0}}</text><view>{{item.label}}</view></view></view>
  <view class="section-title">今日特价（{{specialDishes.length}}）</view><view wx:if="{{specialDishes.length}}" class="special-list"><view class="card dish" wx:for="{{specialDishes}}" wx:key="id" bindtap="edit" data-dish="{{item}}"><view><view>{{item.name}}</view><view class="muted">{{item.canteenName}} · {{item.stallName}} · 原价 ¥{{item.price}}</view></view><view class="special-actions"><text>¥{{item.specialPrice}}</text><button size="mini" data-id="{{item.id}}" bindtap="clearSpecial">撤销</button></view></view></view><view wx:else class="empty-special">暂无特价菜品。可在下方搜索菜品后设置。</view>
  <view class="section-title">待回复的饭搭子来信（{{feedbacks.length}}）</view><view wx:if="{{feedbacks.length}}"><view class="card feedback" wx:for="{{feedbacks}}" wx:key="id"><view class="feedback-body"><view class="feedback-meta">{{item.nickname}} · {{item.feedback_type}}</view><view class="feedback-content">{{item.content}}</view><view class="muted">北京时间 {{item.createTime}}</view><textarea maxlength="500" placeholder="写一句真诚的回复，用户将在“我的”中看到" value="{{feedbackReplies[item.id]}}" data-id="{{item.id}}" bindinput="feedbackReplyInput"/><button size="mini" data-id="{{item.id}}" bindtap="resolveFeedback">回复并办结</button></view></view></view><view wx:else class="empty-special">暂时没有需要回复的来信。</view>
  <view class="section-title">待处理社区举报（{{contentReports.length}}）</view><view wx:if="{{contentReports.length}}"><view class="card report-review" wx:for="{{contentReports}}" wx:key="id"><view class="feedback-meta">{{item.reporterNickname}} 举报了{{item.targetType === 'post' ? '帖子' : '评论'}} · {{item.reason}}</view><view class="feedback-content">{{item.targetContent}}</view><view class="muted">北京时间 {{item.createTime}}</view><view class="report-actions"><button size="mini" data-id="{{item.id}}" data-action="dismiss" bindtap="handleContentReport">忽略举报</button><button size="mini" class="reject" data-id="{{item.id}}" data-action="remove" bindtap="handleContentReport">移除内容</button></view></view></view><view wx:else class="empty-special">暂时没有待处理举报。</view>
  <view class="section-title">待审核实拍图</view><view class="card review" wx:for="{{photos}}" wx:key="id"><image src="{{item.imageUrl}}" mode="aspectFill"/><view><view>{{item.dishName}}</view><view class="muted">{{item.nickname}} 投稿</view><button size="mini" data-type="photo" data-action="approve" data-id="{{item.id}}" bindtap="review">通过并设为主图</button><button size="mini" class="reject" data-type="photo" data-action="reject" data-id="{{item.id}}" bindtap="review">拒绝</button></view></view>
  <view class="section-title">待审核上新情报</view><view class="card content" wx:for="{{reports}}" wx:key="id"><view>{{item.dish_name}}<view class="muted">{{item.canteen_name}} · {{item.stall_name}}</view></view><view><text data-type="report" data-action="approve" data-id="{{item.id}}" bindtap="review">通过</text><text class="delete" data-type="report" data-action="reject" data-id="{{item.id}}" bindtap="review">拒绝</text></view></view>
  <view class="section-title">编辑菜品价格与特价</view><view class="search"><input placeholder="输入菜名" value="{{q}}" bindinput="input" bindconfirm="search"/><button size="mini" bindtap="search">查找</button></view><view class="card dish" wx:for="{{dishes}}" wx:key="id" bindtap="edit" data-dish="{{item}}"><view><view>{{item.name}}</view><view class="muted">{{item.canteenName}} · {{item.stallName}}</view></view><text>¥{{item.specialPrice || item.price}} ›</text></view>
  <view class="section-title">最新帖子</view><view class="card content" wx:for="{{posts}}" wx:key="id"><view>{{item.nickname}}：{{item.content}}</view><text bindtap="removePost" data-id="{{item.id}}">删除</text></view>
  <view class="section-title">最新评论</view><view class="card content" wx:for="{{comments}}" wx:key="id"><view>{{item.nickname}}：{{item.content}}</view><text bindtap="removeComment" data-id="{{item.id}}" data-source="{{item.source}}">删除</text></view>
  <view wx:if="{{editing}}" class="mask"><view class="editor"><view class="editor-title">修改 {{editing.name}}</view><view class="editor-label">原价</view><input type="digit" value="{{price}}" bindinput="priceInput"/><button class="primary-btn" bindtap="savePrice">保存原价</button><view class="editor-label">特价（留空并点撤销，可取消特价）</view><input type="digit" placeholder="例如：8.8" value="{{specialPrice}}" bindinput="specialInput"/><button class="special-btn" bindtap="saveSpecial">设置特价</button><button class="clear-btn" bindtap="clearSpecial">撤销特价</button><view class="cancel" bindtap="closeEdit">取消</view></view></view>
</view>
