.login{padding:150rpx 55rpx}.logo{margin:auto;width:118rpx;height:118rpx;border-radius:50%;background:#b87a36;color:#fff;display:flex;align-items:center;justify-content:center;font-family:Georgia,serif;font-size:53rpx;box-shadow:0 12rpx 25rpx rgba(110,74,36,.2)}.title{text-align:center;font-family:Georgia,serif;font-size:45rpx;font-weight:bold;margin:20rpx 0}.intro{text-align:center;color:#8a7a70;margin-bottom:70rpx}.login button{margin-top:20rpx}.privacy{text-align:center;color:#a39489;font-size:21rpx;margin-top:25rpx}.profile-mask{position:fixed;z-index:100;inset:0;background:rgba(65,52,44,.35)}.profile-panel{position:absolute;left:32rpx;right:32rpx;top:50%;transform:translateY(-50%);background:#fff;border-radius:32rpx;padding:42rpx 32rpx}.eyebrow{font-family:Georgia,serif;color:#a58b6b;font-size:19rpx;letter-spacing:3rpx}.profile-title{font-family:Georgia,serif;font-size:37rpx;font-weight:bold;margin:12rpx 0}.nickname-input{box-sizing:border-box;width:100%;background:#f3f0e7;border-radius:16rpx;padding:20rpx;margin:24rpx 0}.avatar-title{font-weight:600;color:#6b523c;margin-bottom:14rpx}.avatar-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:15rpx}.avatar-choice{height:75rpx;border-radius:20rpx;background:#f3eee5;color:#76553a;display:flex;align-items:center;justify-content:center;font-family:Georgia,serif;font-size:31rpx;border:2rpx solid transparent}.avatar-choice.selected{background:#e4c994;border-color:#b87a36;color:#5b402a}.skip{text-align:center;color:#9c8069;font-size:22rpx;margin-top:22rpx}
