<view class="page" wx:if="{{post}}"><view class="card"><view class="author"><view class="avatar">{{post.avatarLabel}}</view>{{post.nickname}}</view><view class="content">{{post.content}}</view><image wx:for="{{post.images}}" wx:key="*this" src="{{item}}" class="img" mode="aspectFill"/><view class="foot"><text>{{post.createTime}}</text><view class="post-actions"><text class="like {{post.liked ? 'liked' : ''}}" bindtap="like">{{post.liked ? '♥ 已点赞' : '♡ 点赞'}} {{post.likeCount}}</text><text wx:if="{{post.isOwner}}" bindtap="removePost">删除</text><text wx:else data-type="post" data-id="{{post.id}}" bindtap="report">举报</text></view></view></view><view class="section-title">评论 {{comments.length}}</view><view class="card comment {{item.highlight ? 'highlight' : ''}} {{item.parentId ? 'reply-comment' : ''}} {{item.isDeleted ? 'deleted-comment' : ''}}" wx:for="{{comments}}" wx:key="id"><view class="author"><view class="avatar">{{item.avatarLabel}}</view><view>{{item.nickname}}<text wx:if="{{item.parentNickname}}"> 回复 {{item.parentNickname}}</text></view></view><view>{{item.content}}</view><view wx:if="{{!item.isDeleted}}" class="muted">{{item.createTime}} <text class="reply" data-comment="{{item}}" bindtap="reply">回复</text><text wx:if="{{item.isOwner}}" class="comment-action" data-id="{{item.id}}" bindtap="removeComment">删除</text><text wx:else class="comment-action" data-type="comment" data-id="{{item.id}}" bindtap="report">举报</text></view></view><view wx:if="{{replyTarget}}" class="reply-tip">回复 {{replyTarget.nickname}} <text bindtap="cancelReply">×</text></view><view class="comment-box"><input placeholder="{{replyTarget ? '写下你的回复…' : '说点什么…'}}" value="{{content}}" bindinput="input"/><button size="mini" bindtap="comment">发送</button></view></view>
