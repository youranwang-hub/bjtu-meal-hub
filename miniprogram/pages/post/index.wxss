.author{display:flex;align-items:center;gap:12rpx;font-weight:bold;margin-bottom:14rpx}.avatar{width:42rpx;height:42rpx;border-radius:50%;background:#e1c999;color:#735538;display:flex;align-items:center;justify-content:center;font-family:Georgia,serif;font-size:20rpx;flex:none}.author text{font-weight:normal;color:#a27e5b;font-size:22rpx}.content{line-height:1.65;margin-bottom:15rpx}.img{width:100%;height:380rpx;border-radius:20rpx;margin-bottom:13rpx}.foot{display:flex;justify-content:space-between;color:#948378;font-size:22rpx}.post-actions{display:flex;align-items:center;gap:16rpx}.post-actions>text:last-child{color:#a78061}.like{padding:4rpx 10rpx;border-radius:16rpx}.like.liked{color:#b65850;background:#f9e6e2;font-weight:600}.comment.highlight{animation:flash 1.2s ease;background:#f0dfb9}.reply-comment{margin-left:34rpx;background:#fbf8f2;border-left:5rpx solid #e7d5b7}.deleted-comment{opacity:.72}.reply{margin-left:18rpx;color:#ad7438}.comment-action{margin-left:18rpx;color:#9b8069}.reply-tip{position:fixed;left:25rpx;right:25rpx;bottom:96rpx;background:#e9d1a6;padding:13rpx 22rpx;border-radius:18rpx;color:#684a31}.reply-tip text{float:right;font-size:30rpx}.comment-box{position:fixed;left:20rpx;right:20rpx;bottom:18rpx;background:#fff;border-radius:30rpx;padding:12rpx;display:flex;box-shadow:0 5rpx 20rpx rgba(0,0,0,.1)}.comment-box input{flex:1;padding:10rpx}.comment-box button{background:#b87a36;color:#fff;border-radius:20rpx}@keyframes flash{0%,100%{background:#fff}45%{background:#f0dfb9}}
