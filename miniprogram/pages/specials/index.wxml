<view class="page"><view class="intro">每周实惠一点，吃饭开心一点。</view><view class="card item" wx:for="{{dishes}}" wx:key="id" bindtap="dish" data-id="{{item.id}}"><image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill"/><view><view>{{item.name}}</view><view class="muted">{{item.canteenName}} · {{item.stallName}}</view><text class="old">¥{{item.price}}</text><text class="price">¥{{item.specialPrice}}</text></view></view><view wx:if="{{!dishes.length}}" class="empty">本周暂无特价菜品</view></view>
