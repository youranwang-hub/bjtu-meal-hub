<view class="page" wx:if="{{dish}}"><view class="hero-wrap"><image wx:if="{{dish.imageUrl}}" class="hero" src="{{dish.imageUrl}}" mode="aspectFill"/><view class="image-note">{{dish.imageLabel}}</view></view><view class="card"><view class="title">{{dish.name}}</view><view class="muted">{{dish.canteenName}} · {{dish.stallName}}</view><view class="price big">¥{{dish.specialPrice || dish.price}}</view><view><text class="tag" wx:for="{{dish.tags}}" wx:key="*this">{{item}}</text></view></view><view class="card"><view class="title">综合评分 {{dish.rating || '暂无'}}</view><view class="stars"><text wx:for="{{[1,2,3,4,5]}}" wx:key="*this" bindtap="score" data-score="{{item}}">{{item <= score ? '★' : '☆'}}</text></view><button class="primary-btn" bindtap="rate">提交 {{score}} 分评分</button></view><view class="photo-call card"><view><view class="title">{{dish.hasRealImage ? '同学实拍图' : '暂无真实图片'}}</view><view class="muted">{{dish.hasRealImage ? '已有 ' + dish.photoCount + ' 位同学贡献' : '你吃过这道菜吗？上传第一张实拍图吧'}}</view></view><button class="upload-btn" bindtap="upload">上传实拍</button></view></view>
