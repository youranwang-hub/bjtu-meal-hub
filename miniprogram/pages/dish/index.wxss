.hero-wrap{position:relative}.hero{width:100%;height:360rpx;border-radius:20rpx;background:#eee}.image-note{position:absolute;right:16rpx;bottom:16rpx;background:rgba(65,52,44,.7);color:#fff;padding:7rpx 13rpx;border-radius:16rpx;font-size:20rpx}.title{font-size:38rpx;font-weight:700}.big{font-size:40rpx;margin:15rpx 0}.tag{display:inline-block;background:#fff0e9;color:#e95b35;padding:5rpx 12rpx;border-radius:20rpx;margin-right:10rpx}.stars{font-size:52rpx;color:#f2ad32;margin:16rpx 0}.photo-call{display:flex;align-items:center;justify-content:space-between}.upload-btn{background:#e4d0a8;color:#604832;border-radius:22rpx;font-size:23rpx}
